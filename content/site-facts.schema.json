{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourfamilyfirstinsurance3.com/schemas/site-facts.schema.json",
  "title": "YFFI3 verified site facts",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteUrl", "businessName", "brandName", "phone", "address", "quoteDestination", "serviceAreas", "insuranceTypes", "approvedAssetPaths", "contentBoundaries"],
  "properties": {
    "$schema": { "type": "string" },
    "siteUrl": { "const": "https://yourfamilyfirstinsurance3.com" },
    "businessName": { "const": "Your Family First Insurance Office #3" },
    "brandName": { "const": "Your Family First Insurance" },
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "tel", "sms"],
      "properties": {
        "display": { "const": "305-910-8850" },
        "tel": { "const": "tel:13059108850" },
        "sms": { "const": "sms:+13059108850" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streetAddress", "addressLocality", "addressRegion", "postalCode", "addressCountry"],
      "properties": {
        "streetAddress": { "const": "11200 W Flagler St, Suite 108-109" },
        "addressLocality": { "const": "Miami" },
        "addressRegion": { "const": "FL" },
        "postalCode": { "const": "33174" },
        "addressCountry": { "const": "US" }
      }
    },
    "quoteDestination": { "type": "string", "format": "uri", "const": "https://secure.ConsumerRateQuotes.com/ConsumerV2?id=64868" },
    "serviceAreas": { "const": ["Miami", "Sweetwater", "Doral", "Hialeah", "Kendall", "Florida"] },
    "insuranceTypes": { "const": ["Auto insurance", "Homeowners insurance", "Renters insurance", "Flood insurance", "Motorcycle insurance", "Boat insurance", "RV insurance", "Commercial insurance", "Business insurance", "General liability insurance", "Workers' compensation insurance", "Life insurance", "Health insurance"] },
    "approvedAssetPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialLogo", "originalLogo", "familyPhoto", "familyPhotoWebp", "principalPhoto", "quoteQr"],
      "properties": {
        "officialLogo": { "type": "string", "pattern": "^/assets/yffi3/" },
        "originalLogo": { "type": "string", "pattern": "^/assets/yffi3/" },
        "familyPhoto": { "type": "string", "pattern": "^/assets/yffi3/" },
        "familyPhotoWebp": { "type": "string", "pattern": "^/assets/yffi3/" },
        "principalPhoto": { "type": "string", "pattern": "^/assets/yffi3/" },
        "quoteQr": { "type": "string", "pattern": "^/assets/yffi3/" }
      }
    },
    "contentBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibitedClaims", "disclaimer"],
      "properties": {
        "prohibitedClaims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "disclaimer": { "type": "string", "minLength": 20 }
      }
    }
  }
}
